{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prepare SDL2 dependencies",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/setup-sdl.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build TheFinder",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/.vscode/build.ps1"
			],
			"dependsOn": "Prepare SDL2 dependencies",
			"dependsOrder": "sequence",
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}